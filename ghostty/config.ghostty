font-family = "0xProGen"
font-size = 15.5
adjust-cell-height = -10%
adjust-icon-height = 10%
font-synthetic-style = true
# theme = dark:nord,light:github
font-feature = liga,-calt
font-codepoint-map = U+23E9-U+23FA=FreeSans
window-height = 38
window-width = 85
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
window-padding-color = extend
window-subtitle = false
window-theme = auto
title = "Terminal"
mouse-hide-while-typing = true
right-click-action = copy-or-paste
focus-follows-mouse = true
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false
copy-on-select = clipboard
keybind = alt+v=paste_from_clipboard
keybind = alt+n=new_window
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env
bell-features = no-system,no-audio,no-attention,title,no-border
gtk-titlebar = true
gtk-tabs-location = hidden
gtk-titlebar-hide-when-maximized = true
gtk-titlebar-style = native
gtk-toolbar-style = raised-border
term = xterm-256color
